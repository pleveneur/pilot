# Dependencies
node_modules/

# Build output
dist/
target/

# Tauri build
src-tauri/target/

# Environment
.env
.env.*
# Le MODÈLE de variables d'environnement du serveur GDS est versionné : il ne
# contient aucun secret (`gds-server/.env.example`, refonte GDS L2.8). Seul le
# fichier réel `.env` reste ignoré.
!**/.env.example

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Pi extensions node_modules (already covered by node_modules/ above)
.pi/extensions/*/node_modules/

# Generated extension bundle (MCP POC) — regenerated by `npm run build:mcp`
src-tauri/extensions/pilot-mcp-client.ts

# Local config overrides
*.local

# Local project data (plan.json, tests artifacts, etc.)
.pilot/

# Local dev/temp files
nul

# Temp release/issue dumps (API GitHub)
issues_tmp.json
r*.json
rel_v*.json
_fix_md.js
exemplesession.jsonl
sessions.md
rtk_analyse.md
pi-docs/
rapport_tmp.md

# GitHub Actions debug artifacts
jobs.json
jobs.txt
logs.txt
runs.json
runs.txt
# Release artefacts (jetables, générés par scripts/gen-latest-json.js)
rel.json
latest.json

# Sauvegardes locales des volumes GDS (scripts/gds-reload.js) — volumineuses et
# propres au poste : jamais versionnées.
gds-server/backups/

# Ressources du service Laya préparées au moment de la construction depuis un
# dépôt EXTERNE (scripts/prepare-laya.js) : jamais versionnées (licence et dépôt
# distincts, 114 Mo dont un interpréteur Node). Embarquées dans le paquet livré
# via bundle.resources.
src-tauri/laya/
